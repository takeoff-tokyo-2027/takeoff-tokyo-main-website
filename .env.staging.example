# Copy to .env.staging.local for a staging frontend build.
# Set backend and Brevo values as secrets in the website Worker's Previews Base.
# The optional staging retry Worker needs its own matching credentials.
# Never place these values on the production deployment.
VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
APP_ENV=staging
SUPABASE_DB_SCHEMA=staging
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional, independent staging admin bootstrap list; never inherited from production.
ADMIN_BOOTSTRAP_EMAILS=
# Stripe sandbox webhook: <SITE_URL>/api/stripe-webhook
SITE_URL=https://dev-takeoff-tokyo-main-website.ankhasgreens.workers.dev
# Catalog pricing requires Products/Prices read+write; checkout also needs Checkout/Coupons write and Charges read.
STRIPE_SECRET_KEY=
# Signing secret for the registered staging endpoint above; separate from live/CLI secrets.
STRIPE_WEBHOOK_SECRET=
# Generate an independent value: openssl rand -hex 32
QR_SIGNING_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
STAGING_EMAIL_ALLOWLIST=
