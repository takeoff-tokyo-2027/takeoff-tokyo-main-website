# Copy to .env.staging.local for a staging frontend build.
# Set the same backend values as secrets on the Cloudflare Pages PREVIEW environment and the staging email Worker.
# Never place these values on the production deployment.
VITE_APP_ENV=staging
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
APP_ENV=staging
SUPABASE_DB_SCHEMA=staging
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://dev.takeoff-tokyo-main-website.pages.dev
# Catalog pricing requires Products/Prices read+write; checkout also needs Checkout/Coupons write and Charges read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Generate an independent value: openssl rand -hex 32
QR_SIGNING_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
STAGING_EMAIL_ALLOWLIST=
