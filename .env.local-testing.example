# Generated local Supabase credentials go in .env.local-testing.local via npm run local:prepare.
# Never copy production values here. This file is an optional override template.
# Put only a Stripe SANDBOX key and its local CLI webhook secret in .env.local-testing.local.
# Catalog pricing requires Products/Prices read+write; checkout also needs Checkout/Coupons write and Charges read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
