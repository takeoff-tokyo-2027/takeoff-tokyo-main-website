# Copy to .dev.vars for manual wrangler dev. Set real deployments as Cloudflare secrets.
SITE_URL=http://localhost:8788
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional admin bootstrap list for this environment only.
ADMIN_BOOTSTRAP_EMAILS=
# Catalog pricing requires Products/Prices read+write; checkout also needs Checkout/Coupons write and Charges read.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
QR_SIGNING_SECRET=
# Website Worker email delivery (separate from Supabase Auth SMTP)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
