# Production-only settings for Cloudflare Production (main).
# The workspace .env is a sandbox baseline; do not reuse its Stripe test key here.
# Set VITE_* as build variables and server values as runtime secrets.
VITE_APP_ENV=production
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
APP_ENV=production
SUPABASE_DB_SCHEMA=public
SITE_URL=https://YOUR-PRODUCTION-DOMAIN
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Live key: rk_live_ or sk_live_. Sandbox keys are rejected.
# Catalog pricing requires Products/Prices read+write; checkout also needs Checkout/Coupons write and Charges read.
STRIPE_SECRET_KEY=
# Signing secret for the PRODUCTION webhook endpoint only.
STRIPE_WEBHOOK_SECRET=
# Independent production signing key; generate with openssl rand -hex 32.
QR_SIGNING_SECRET=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
